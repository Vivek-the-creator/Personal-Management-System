NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/doodo_dev

# JWT secrets — MUST be at least 32 chars each, MUST be different
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token expiry durations (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Client ID
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized JavaScript origins: http://localhost:5173
# 5. Add Authorized redirect URIs: http://localhost:5173
GOOGLE_CLIENT_ID=

# Cookie signing secret (at least 16 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
